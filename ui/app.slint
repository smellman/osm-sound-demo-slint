import { Button, ListView, Slider, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { MapView, MapAdapter } from "map-view.slint";

export { MapAdapter }

// Pixel size of the map view, pushed to the backend so the headless renderer
// can be rebuilt at the matching resolution.
export struct Size {
    width: length,
    height: length,
}


// A dropdown whose list can be dragged with a finger.
//
// `ComboBox` puts its model in a `ScrollView`, and every style leaves that
// view's `mouse-drag-pan-enabled` — the inner `Flickable`'s `interactive` —
// off, so the list moves by wheel or scrollbar and not by dragging it. The
// widget does not expose the property, so with the stock `ComboBox` there is no
// way to turn it on from outside. `ListView` inherits `ScrollView`, so a popup
// built here can.
component TouchComboBox {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    callback selected(/* index */ int);

    // The bottom bar's list has to open upwards; the map overlay's drops down.
    in property <bool> drop-up: false;
    // How tall the list may grow before it starts scrolling.
    in property <length> max-list-height: 260px;

    property <length> row-height: 34px;
    property <length> list-height: min(root.max-list-height, root.model.length * root.row-height + 8px);

    Rectangle {
        background: #2a2f38;
        border-radius: 4px;
        border-width: 1px;
        border-color: touch.has-hover ? #4a5162 : #3a4150;

        Text {
            x: 10px;
            width: parent.width - 34px;
            height: 100%;
            text: root.model[root.current-index];
            color: #e8ecf3;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }

        // The chevron, drawn rather than imported so the widget carries no assets.
        Text {
            x: parent.width - 20px;
            height: 100%;
            text: "▾";
            color: #99a2b3;
            font-size: 11px;
            vertical-alignment: center;
        }

        touch := TouchArea {
            clicked => {
                popup.show();
            }
        }
    }

    popup := PopupWindow {
        // Without this the default `close-on-click` closes the popup on any
        // click at all, taking it away before the row's own `TouchArea` sees
        // the tap — the list disappears and nothing is selected. `ComboBox`
        // sets the same policy for the same reason.
        close-policy: close-on-click-outside;
        x: 0;
        y: root.drop-up ? -root.list-height - 4px : root.height + 4px;
        width: root.width;
        height: root.list-height;

        Rectangle {
            background: #171a20;
            border-radius: 6px;
            border-width: 1px;
            border-color: #3a4150;

            list := ListView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                // The whole point: without this the list ignores a drag.
                mouse-drag-pan-enabled: true;

                for value[index] in root.model: Rectangle {
                    height: root.row-height;
                    background: index == root.current-index
                        ? #1f6feb
                        : (row-touch.has-hover ? #262b34 : transparent);
                    border-radius: 4px;

                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text: value;
                        color: #e8ecf3;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    row-touch := TouchArea {
                        clicked => {
                            root.current-index = index;
                            root.selected(index);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "OpenStreetMap Sound Demo";
    // Opens full screen: this is something to stand in front of, driven from a
    // gamepad, not a window to keep alongside other work. Escape leaves it, F
    // toggles and Q quits, since a full-screen window has no title bar to
    // click.
    // Rust sets `windowed` before the window opens when asked to.
    in-out property <bool> windowed: false;
    full-screen: !root.windowed;
    // Used when it leaves full screen.
    preferred-width: 1024px;
    preferred-height: 720px;
    background: #16181d;
    forward-focus: keys;

    out property <Size> map-size: { width: map.width, height: map.height };
    callback map-size-changed;
    changed map-size => {
        root.map-size-changed();
    }

    // --- in: model data filled in by Rust ---
    in property <[string]> releases;
    in property <[string]> places;
    in property <string> track-title: "No track selected, please select a release.";
    in property <string> status;
    // What the style's sources say has to be credited.
    in property <string> attribution;
    in property <bool> playing: false;
    in property <bool> busy: false;
    in property <bool> has-release: false;
    in property <bool> vj: false;
    // Two-way so a gamepad's L1/R1 moves the dropdown as well as the map.
    in-out property <int> place-index: 0;
    // Two-way so the gamepad's D-pad moves the release dropdown too.
    in-out property <int> release-index: 0;
    // Two-way so L2/R2 move the slider as well as the output level.
    in-out property <float> volume: 100;

    // --- callbacks: UI -> Rust ---
    callback release-selected(/* index */ int);
    callback place-selected(/* index */ int);
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback volume-changed(/* 0.0 - 1.0 */ float);
    callback open-release();
    callback open-project();
    callback locate-me();
    callback toggle-vj();
    // One of "a", "b", "x", "y" — the gamepad's face buttons, from the keyboard.
    callback face-button(/* button */ string);
    callback quit();

    property <bool> about-open: false;

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.windowed = true;
                return accept;
            }
            if event.text == "f" || event.text == "F" {
                root.windowed = !root.windowed;
                return accept;
            }
            if event.text == "q" || event.text == "Q" {
                root.quit();
                return accept;
            }
            // The pad's face buttons, laid out the way they sit on the pad
            // rather than by their letters: I on top for Y, K below it for A,
            // J and L either side for X and B. The shape is what carries over,
            // so a hand that knows the pad knows these.
            if event.text == "i" || event.text == "I" {
                root.face-button("y");
                return accept;
            }
            if event.text == "k" || event.text == "K" {
                root.face-button("a");
                return accept;
            }
            if event.text == "j" || event.text == "J" {
                root.face-button("x");
                return accept;
            }
            if event.text == "l" || event.text == "L" {
                root.face-button("b");
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            Rectangle {
                vertical-stretch: 1;

                VerticalLayout {
                    map := MapView { }
                }

                // --- overlay: top-left "About" ---
                // The overlays sit on the map, whose brightness varies with the
                // style and the animation, so each gets its own dark backing.
                Rectangle {
                    x: 12px;
                    y: 12px;
                    width: 88px;
                    height: 32px;
                    background: #0d0f13cc;
                    border-radius: 6px;

                    Button {
                        width: 100%;
                        height: 100%;
                        text: "About";
                        clicked => {
                            root.about-open = !root.about-open;
                        }
                    }
                }

                // --- overlay: top-right "Fly To" ---
                Rectangle {
                    x: parent.width - self.width - 12px;
                    y: 12px;
                    width: 220px;
                    height: 32px;
                    TouchComboBox {
                        width: 100%;
                        height: 100%;
                        model: root.places;
                        current-index <=> root.place-index;
                        selected(index) => {
                            root.place-selected(index);
                        }
                    }
                }

                // --- overlay: top-right "VJ Mode" ---
            Rectangle {
                x: parent.width - self.width - 360px;
                y: 12px;
                width: 110px;
                height: 32px;
                background: root.vj ? #1f6feb : #0d0f13cc;
                border-radius: 6px;

                Button {
                    width: 100%;
                    height: 100%;
                    text: root.vj ? "VJ: on" : "VJ Mode";
                    clicked => {
                        root.toggle-vj();
                    }
                }
            }

            // --- overlay: top-right "Locate Me" ---
            Rectangle {
                x: parent.width - self.width - 244px;
                y: 12px;
                width: 110px;
                height: 32px;
                background: #0d0f13cc;
                border-radius: 6px;

                Button {
                    width: 100%;
                    height: 100%;
                    text: "Locate Me";
                    clicked => {
                        root.locate-me();
                    }
                }
            }

            // --- overlay: bottom-left status line ---
                Rectangle {
                    x: 12px;
                    y: parent.height - self.height - 12px;
                    width: status-text.preferred-width + 16px;
                    height: status-text.preferred-height + 8px;
                    background: #0d0f13cc;
                    border-radius: 4px;

                    status-text := Text {
                        text: root.status;
                        color: #cdd4de;
                        font-size: 11px;
                    }
                }

                // --- overlay: about panel ---
                if root.about-open: Rectangle {
                    x: 12px;
                    y: 56px;
                    width: min(520px, parent.width - 24px);
                    height: about-text.preferred-height + 72px;
                    background: #0d0f13e6;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #2c313b;

                    about-text := Text {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        wrap: word-wrap;
                        color: #dfe4ec;
                        font-size: 12px;
                        text: "OpenStreetMap Sound Demo — native rebuild with MapLibre Native + Slint + rodio.\n\n"
                            + "Map data © OpenStreetMap contributors, tiles by tile.openstreetmap.jp (© OpenMapTiles).\n"
                            + "All music by Otherman Records (CC BY-NC 2.1 JP).\n"
                            + "Original sound example by Mapbox (dancing buildings).\n"
                            + "Developed by Taro Matsuzawa (smellman).\n\n"
                            + "Gamepad (Xbox layout): Start plays, Select stops, L1/R1 fly between cities, "
                            + "A drops, B orbits, X cuts the skyline finer, Y switches the colouring, "
                            + "D-pad picks track and release, "
                            + "L2/R2 set volume.\n"
                            + "Escape leaves full screen, F toggles it, Q quits. "
                            + "I/J/K/L are the pad's Y/X/A/B, laid out as they sit on the pad.\n\n"
                            + "VJ mode drives the map from whatever the input device hears instead of "
                            + "from a track, so it follows a live mix. Route the sound you are playing "
                            + "into an input first: Loopback.app on macOS, Helvum with PipeWire on Linux. "
                            + "OSM_SOUND_DEMO_INPUT picks the device by name.";
                    }

                    Button {
                        x: 16px;
                        y: about-text.preferred-height + 24px;
                        width: 200px;
                        text: "Source on GitHub";
                        clicked => {
                            root.open-project();
                        }
                    }
                }
            }

            // --- bottom transport bar ---
            Rectangle {
                height: 64px;
                background: #1e2128;

                HorizontalBox {
                    padding: 8px;
                    spacing: 8px;
                    alignment: stretch;

                    Button {
                        width: 44px;
                        text: "◀◀";
                        enabled: root.has-release;
                        clicked => {
                            root.prev-track();
                        }
                    }

                    Button {
                        width: 44px;
                        text: root.playing ? "■" : "▶";
                        enabled: root.has-release && !root.busy;
                        clicked => {
                            root.toggle-play();
                        }
                    }

                    Button {
                        width: 44px;
                        text: "▶▶";
                        enabled: root.has-release;
                        clicked => {
                            root.next-track();
                        }
                    }

                    Text {
                        text: "Vol";
                        color: #b9c0cc;
                        vertical-alignment: center;
                    }

                    Slider {
                        width: 96px;
                        minimum: 0;
                        maximum: 100;
                        value <=> root.volume;
                        changed value => {
                            root.volume-changed(self.value / 100);
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 2;
                        background: #0d0f13;
                        border-radius: 4px;
                        clip: true;

                        property <string> line: root.busy ? "Loading… " + root.track-title : root.track-title;
                        // Only scroll a title that does not fit; a short one
                        // sits still rather than sliding for no reason.
                        property <bool> scrolling: title.preferred-width > self.width - 16px;
                        // How far the text travels before starting over: its
                        // own width plus the box, so it leaves on the left
                        // before returning on the right.
                        property <length> span: title.preferred-width + self.width;
                        property <length> travelled: 0px;

                        // Driven by a timer rather than `animation-tick`, which
                        // only advances while something else is animating.
                        Timer {
                            interval: 32ms;
                            running: parent.scrolling;
                            triggered => {
                                parent.travelled = parent.travelled >= parent.span
                                    ? 0px
                                    : parent.travelled + 2px;
                            }
                        }

                        title := Text {
                            x: parent.scrolling ? parent.width - parent.travelled : 8px;
                            height: 100%;
                            text: parent.line;
                            color: #e8ecf3;
                            vertical-alignment: center;
                        }
                    }

                    TouchComboBox {
                        horizontal-stretch: 3;
                        model: root.releases;
                        current-index <=> root.release-index;
                        drop-up: true;
                        selected(index) => {
                            root.release-selected(index);
                        }
                    }

                    Button {
                        text: "Go To Release";
                        enabled: root.has-release;
                        clicked => {
                            root.open-release();
                        }
                    }
                }
            }
        }
    }
}
